# 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# (선택) 에이전트 모델. 비우면 claude-sonnet-5-5. 시연·테스트는 claude-haiku-5-5 처럼 가벼운 모델도 돼요
ANTHROPIC_MODEL=

# (선택) 돌담지기를 Claude 대신 Google Gemini(무료 키)로 돌릴 때 — https://aistudio.google.com/apikey 에서 만든 키
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # 비우면 기본값. 답이 아쉬우면 gemini-3.8-flash
# AGENT_PROVIDER=gemini                # gemini | claude (비우면 GEMINI_API_KEY 가 있을 때 Gemini)
